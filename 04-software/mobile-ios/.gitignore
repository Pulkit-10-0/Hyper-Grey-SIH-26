# SeaNergy - iOS target.
#
# The native ios/ project IS tracked here. It was generated by
# `expo prebuild --platform ios` and is a real Xcode project, not a placeholder.
# Excluded below: CocoaPods output, Xcode build output, per-user state, and
# anything that is a signing credential.

# ---- dependencies -----------------------------------------------------------
node_modules/
.npm/

# ---- Expo -------------------------------------------------------------------
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# ---- generated output -------------------------------------------------------
.verify-out/
.verify-ios/
*.tsbuildinfo

# ---- CocoaPods --------------------------------------------------------------
# Pods/ is regenerated by `pod install` on the macOS build host.
# Podfile and Podfile.properties.json ARE tracked; Podfile.lock is committed
# once a macOS host has resolved it, so both hosts install identical versions.
ios/Pods/
ios/.xcode.env.local

# ---- Xcode ------------------------------------------------------------------
ios/build/
ios/DerivedData/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
ios/*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# ---- signing: never commit a credential ------------------------------------
*.mobileprovision
*.provisionprofile
*.p8
*.p12
*.cer
*.certSigningRequest
*.key
*.pem
ios/ExportOptions.plist

# ---- self-contained toolchain ----------------------------------------------
.toolchain/*
!.toolchain/env.ps1

# ---- editors and OS ---------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db
*.orig.*

# ---- logs -------------------------------------------------------------------
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# ---- local env --------------------------------------------------------------
.env
.env*.local
