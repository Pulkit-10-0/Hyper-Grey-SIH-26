; Expo SDK 57 ships a devtools tree whose react-dom@19.2.8 declares a peer of
; react@^19.2.8 while the app pins react@19.2.3. That conflict is internal to
; Expo's own tooling and does not affect the app, but it makes npm refuse every
; subsequent install. Legacy peer resolution keeps installs working.
legacy-peer-deps=true
fund=false
audit=false
