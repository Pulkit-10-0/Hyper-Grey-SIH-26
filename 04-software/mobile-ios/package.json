{
  "name": "seanergy",
  "version": "2.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/rajdhani": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@shopify/react-native-skia": "2.6.2",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.14",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.1",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-screen-orientation": "~57.0.1",
    "expo-sharing": "~57.0.15",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "^30.5.0",
    "jest-expo": "^57.0.5",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --platform android --clean && node scripts/apply-android-config.mjs",
    "prebuild:ios": "expo prebuild --platform ios",
    "apk:debug": "expo run:android --variant debug",
    "apk:release": "expo run:android --variant release --no-install --no-bundler",
    "typecheck": "tsc --noEmit",
    "verify": "tsc -p tsconfig.verify.json && node .verify-out/core/__verify__.js",
    "clean:verify": "node -e \"require('fs').rmSync('.verify-out',{recursive:true,force:true})\"",
    "android:config": "node scripts/apply-android-config.mjs",
    "apk": "npm run check && node scripts/apply-android-config.mjs && cd android && gradlew.bat assembleRelease --no-daemon",
    "test": "jest --ci",
    "check": "tsc --noEmit && npm run verify && jest --ci",
    "bundle:ios": "expo export --platform ios --output-dir .verify-ios",
    "site-data": "node scripts/site-data.mjs"
  },
  "private": true,
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
