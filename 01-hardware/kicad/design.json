  "sheets": [
    {
      "id": "controllers",
      "title": "Controllers and power interfaces",
      "description": "ESP32-S3 main/TX and classic ESP32 RX use separate 3.3 V regulator outputs; both share GND. USB powers controllers; no VIN/VBUS tie."
    },
    {
      "id": "power",
      "title": "External 5 V distribution",
      "description": "Regulated external 5 V for transmitter, audio and optional sensor supplies. Fuse limit 1 A; test external rail before use."
    },
    {
      "id": "displays",
      "title": "Four OLED buses and temperature sensor",
      "description": "Four SSD1306 displays at 0x3C on separate I2C buses; optional pull-ups fitted only if modules do not supply suitable pull-ups."
    },
    {
      "id": "sensors",
      "title": "ADS1115 modules and sensor inputs",
      "description": "ADS1=0x48; ADS2=0x49. TDS/TURB 0-5 V inputs are divided by two and isolated when main ADC supply is invalid. Existing firmware sensor voltages need x2 scaling."
    },
    {
      "id": "transmitter",
      "title": "40 kHz TX and I2S audio interfaces",
      "description": "AO3400A level translator and TC4426A inverting driver give noninverted 5 V gate drive. IRLZ44N low-side switch; 1k piezo reset. MAX98357A external module; GAIN left floating."
    },
    {
      "id": "receiver",
      "title": "40 kHz receive amplifier",
      "description": "MCP6002 follower and nominal gain23 amplifier on RX3V3. No slow 100nF filter at GPIO34; verify 40kHz gain and ADC waveform."
    }
  ],
